    {
      "id": 7,
      "type": "timeseries",
      "title": "Alertas en el tiempo por tipo de ataque",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({event_type=\"alert\", alert_signature=~\".*Escaneo de puertos.*\"}[$__interval]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Escaneo de puertos"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({event_type=\"alert\", alert_signature=~\".*denegacion de servicio.*\"}[$__interval]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Denegacion de servicio"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({event_type=\"alert\", alert_signature=~\".*Acceso no autorizado entre VLANs.*\"}[$__interval]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Acceso entre VLANs"
        },
        {
          "refId": "D",
          "expr": "sum(count_over_time({event_type=\"alert\", alert_signature=~\".*Dispositivo no autorizado.*\"}[$__interval]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Dispositivo no autorizado"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Escaneo de puertos"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Denegacion de servicio"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Acceso entre VLANs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
