{
  "uid": "ids-explorador",
  "title": "4. Explorador de alertas",
  "description": "Filtros por fuente, categoria y origen",
  "tags": [
    "ids",
    "laboratorio"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "annotations": {
    "list": [
      {
        "name": "Inicio de ataque",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "type": "tags",
        "tags": [
          "ataque"
        ],
        "matchAny": true,
        "limit": 100
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "fuente",
        "label": "Fuente",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "job",
          "stream": "{event_type=\"alert\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({event_type=\"alert\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "categoria",
        "label": "Categoria",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "alert_category",
          "stream": "{event_type=\"alert\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({event_type=\"alert\"}, alert_category)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "origen",
        "label": "Origen",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "src_ip",
          "stream": "{event_type=\"alert\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({event_type=\"alert\"}, src_ip)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Otros dashboards",
      "type": "dashboards",
      "tags": [
        "ids"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 32,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Explorador de alertas**: usa los selectores de arriba (fuente, categoria, origen) para filtrar. Equivale al dashboard \"Logs por contenedor\" del proyecto UNFV, pero sobre alertas de seguridad."
      }
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Alertas filtradas",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({event_type=\"alert\", job=~\"$fuente\", alert_category=~\"$categoria\", src_ip=~\"$origen\"}[$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Alertas",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Firmas distintas",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (alert_signature) (count_over_time({event_type=\"alert\", job=~\"$fuente\", alert_category=~\"$categoria\", src_ip=~\"$origen\"}[$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Firmas",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 35,
      "type": "stat",
      "title": "Origenes distintos",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (src_ip) (count_over_time({event_type=\"alert\", job=~\"$fuente\", alert_category=~\"$categoria\", src_ip=~\"$origen\"}[$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Origenes",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 36,
      "type": "stat",
      "title": "Destinos distintos",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (dest_ip) (count_over_time({event_type=\"alert\", job=~\"$fuente\", alert_category=~\"$categoria\", src_ip=~\"$origen\"}[$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "Destinos",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 37,
      "type": "bargauge",
      "title": "Alertas por firma",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alert_signature) (count_over_time({event_type=\"alert\", job=~\"$fuente\", alert_category=~\"$categoria\", src_ip=~\"$origen\"}[$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{alert_signature}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Value/"
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "namePlacement": "top",
        "sizing": "auto"
      }
    },
    {
      "id": 38,
      "type": "bargauge",
      "title": "Principales origenes",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (src_ip) (count_over_time({event_type=\"alert\", job=~\"$fuente\", alert_category=~\"$categoria\", src_ip=~\"$origen\"}[$__range])))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{src_ip}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Value/"
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "namePlacement": "top",
        "sizing": "auto"
      }
    },
    {
      "id": 39,
      "type": "timeseries",
      "title": "Alertas filtradas en el tiempo",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alert_signature) (count_over_time({event_type=\"alert\", job=~\"$fuente\", alert_category=~\"$categoria\", src_ip=~\"$origen\"}[$__interval]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{alert_signature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "15s"
    },
    {
      "id": 40,
      "type": "logs",
      "title": "Registro filtrado",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{event_type=\"alert\", job=~\"$fuente\", alert_category=~\"$categoria\", src_ip=~\"$origen\"} | line_format \"{{.job}} | sev {{.alert_severity}} | {{.alert_category}} | {{.alert_signature}} | {{.src_ip}} -> {{.dest_ip}}\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}